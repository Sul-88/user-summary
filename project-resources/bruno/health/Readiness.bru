meta {
  name: Readiness
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/actuator/health/readiness
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Readiness is UP", function () {
    expect(res.getBody().status).to.equal("UP");
  });
}
