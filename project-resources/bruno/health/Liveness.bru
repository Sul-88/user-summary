meta {
  name: Liveness
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/actuator/health/liveness
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Liveness is UP", function () {
    expect(res.getBody().status).to.equal("UP");
  });
}
